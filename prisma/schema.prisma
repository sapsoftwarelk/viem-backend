generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------
// 1. Classification (Categories & SubCategories)
// ---------------------------------------------------------

model Category {
  id            Int           @id @default(autoincrement())
  name          String       
  slug          String        @unique
  subCategories SubCategory[]
  createdAt     DateTime      @default(now())
}

model SubCategory {
  id         Int      @id @default(autoincrement())
  name       String  
  slug       String   @unique
  code       String   @unique // DRL, LRY, CEM
  category   Category @relation(fields: [categoryId], references: [id])
  categoryId Int

  // Relations to actual items
  tools       Tool[]
  vehicles    Vehicle[]
  consumables ConsumableBatch[]
  reusableItems ReusableItem[]
  createdAt   DateTime @default(now())
}

// ---------------------------------------------------------
// 2. Employees & System Users & Roles
// ---------------------------------------------------------

model Employee {
  id            String   @id @default(uuid()) // Format: EMP-DRV-0001
  fullName      String   @map("name")
  employeeId    String   @unique
  photoUrl      String?
  contact       String
  department    String   // ADM, INV, SITE, DRV, REP, FIN
  status        String   @default("ACTIVE")
  employmentType String  @default("Permanent") // Permanent, Temporary, Contract
  joinDate      DateTime @default(now())
  roleId        String?
  role          Role?    @relation(fields: [roleId], references: [id])
  createdAt     DateTime @default(now())

  user User?
}

model User {
  id              String      @id @default(uuid())
  username        String      @unique
  password        String      // Should be hashed
  employeeId      String      @unique // Links to Employee
  employee        Employee    @relation(fields: [employeeId], references: [id])
  roleId          String
  role            Role        @relation(fields: [roleId], references: [id])
  isActive        Boolean     @default(true)
  
  raisedDocuments Document[]
  tripsAsDriver   LorryMovementRecord[] @relation("DriverRelation")
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model Role {
  id             String @id @default(uuid())
  position_title String @unique
  level          String @default("")
  status         String @default("active")
  description    String @default("")

  canCreateUsers       Boolean @default(false)
  canRaisePO           Boolean @default(false)
  canConfirmDeliveries Boolean @default(false)
  canRunAudits         Boolean @default(false)
  canLogMachineHours   Boolean @default(false)

  users     User[]
  employees Employee[]
}


// ---------------------------------------------------------
// 3. Assets & Inventory
// ---------------------------------------------------------

model Tool {
  id              String   @id // Format: TOOL-DRL-0001
  subCategoryId   Int
  subCategory     SubCategory @relation(fields: [subCategoryId], references: [id])
  itemName        String?
  model           String
  description     String?
  supplier        String?
  purchaseDate    DateTime?
  warrantyExpiry  DateTime?
  bladeType       String?
  serialNumber    String   @unique
  condition       String
  
  // Machine Hours
  maxHours        Float    
  cumulativeHours Float    @default(0)
  
  status          ToolStatus @default(IN_WAREHOUSE)
  locationId      String?
  location        SiteLocation? @relation(fields: [locationId], references: [id])
  
  // Link to GRN that created this tool
  grnId           String?
  grn             GoodsReceivedNote? @relation(fields: [grnId], references: [docId])

  goodsIssueNoteItems GoodsIssueNoteItem[]
  maintenance         MaintenanceRecord[]
  movements           MovementHistory[]
}

enum ToolStatus {
  PROCURED
  IN_WAREHOUSE
  READY
  IN_TRANSIT
  ON_SITE
  RETURN_INITIATED
  RETURNING
  RECEIVED_AT_WH
  DAMAGED
  IN_REPAIR
  INSPECTION
  SCRAPPED
}

model Vehicle {
  id                 String   @id // Format: VEH-LRY-0001
  registrationNo     String   @unique
  category           String
  make               String
  model              String
  year               Int
  color              String
  fuelType           String
  status             String   @default("Active")
  notes              String?
  insuranceExpiry    DateTime
  registrationExpiry DateTime
  subCategoryId      Int
  subCategory        SubCategory @relation(fields: [subCategoryId], references: [id])
  trips              LorryMovementRecord[]
}

enum ConsumableBatchStatus {
  AVAILABLE
  DEPLETED
  EXPIRED
}

model ConsumableBatch {
  id              String   @id // Format: CONS-CEM-2026-04-29-001
  subCategoryId   Int
  subCategory     SubCategory @relation(fields: [subCategoryId], references: [id])
  itemName        String
  description     String?
  supplier        String?
  purchaseDate    DateTime?
  batchDate       DateTime?
  receivedDate    DateTime @default(now()) // For FIFO
  expiryDate      DateTime
  quantity        Float    
  unit            String?
  status          ConsumableBatchStatus @default(AVAILABLE)
  originalBatchId String?  // For partial returns to preserve FIFO
  locationId      String?
  location        SiteLocation? @relation(fields: [locationId], references: [id])
  
  // Link to GRN that created this batch
  grnId           String?
  grn             GoodsReceivedNote? @relation(fields: [grnId], references: [docId])

  goodsIssueNoteItems GoodsIssueNoteItem[]
  expiryNotes         ExpiryNote[]
}

model ReusableItem {
  id                 String   @id // Format: REUS-SCF-0001-P003
  itemName           String?
  subCategoryId      Int?
  subCategory        SubCategory? @relation(fields: [subCategoryId], references: [id])
  bundleId           String
  description        String?
  supplier           String?
  purchaseDate       DateTime?
  status             String?
  locationId         String?
  location           SiteLocation? @relation(fields: [locationId], references: [id])
  pieceNum           Int
  individualTracking Boolean? @default(false)
  
  // Link to GRN that created this item
  grnId    String?
  grn      GoodsReceivedNote? @relation(fields: [grnId], references: [docId])

  goodsIssueNoteItems GoodsIssueNoteItem[]
}

model SiteLocation {
  id                 String   @id // Format: SITE-COL-0001-A-L3-S2
  siteName           String
  manager            String   @default("")
  region             String   @default("")
  seq                Int      @default(1)
  status             String   @default("Planning")
  client             String   @default("")
  contactNumber      String   @default("")
  address            String   @default("")
  startDate          DateTime?
  remarks            String   @default("")
  subLevels          Json     @default("[]")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  tools              Tool[]
  consumables        ConsumableBatch[]
  reusableItems      ReusableItem[]
  originTrips        LorryMovementRecord[] @relation("LmrOriginLocation")
  destinationTrips   LorryMovementRecord[] @relation("LmrDestinationLocation")
  goodsIssueNotes     GoodsIssueNote[]
  managerHistory      SiteManagerHistory[]
  purchaseOrders      PurchaseOrder[]     

}

model SiteManagerHistory {
  id        String       @id @default(uuid())
  siteId    String
  site      SiteLocation @relation(fields: [siteId], references: [id])
  manager   String
  fromDate  DateTime
  toDate    DateTime?
  changedAt DateTime     @default(now())
  changedBy String?
}

// ---------------------------------------------------------
// 4. Document System (16 Types)
// ---------------------------------------------------------

model Document {
  id              String   @id // Format: GIN-2026-04-29-001
  type            DocType
  createdAt       DateTime @default(now())
  creatorId       String
  creator         User     @relation(fields: [creatorId], references: [id])
  status          String   
  isAdminApproved Boolean  @default(false)

  poDetails       PurchaseOrder?
  grnDetails      GoodsReceivedNote?
  ginDetails      GoodsIssueNote?
  lmrDetails      LorryMovementRecord?
  exnDetails      ExpiryNote?
}

model Task {
  id          String   @id @default(uuid())
  title       String
  description String?
  priority    String   @default("Medium")
  status      String?  @default("active")
  createdAt   DateTime @default(now())
}

enum DocType {
  PO
  GRN
  SRN
  GIN
  GRIN
  GRNI
  TRN
  DRN
  RWO
  SWO
  THN
  EXN
  MHL
  IAR
  PAR
  LMR
}

enum GINItemType {
  TOOL
  CONSUMABLE
  REUSABLE
}

model PurchaseOrder {
     docId          String        @id
     supplier       String
     siteLocationId String?
     siteLocation   SiteLocation? @relation(fields: [siteLocationId], references: [id])
     totalCost      Float
     expectedDate   DateTime
     document       Document      @relation(fields: [docId], references: [id])
     items          PurchaseOrderItem[]
     grn            GoodsReceivedNote?
   }

   model PurchaseOrderItem {
     id            String        @id @default(uuid())
     poId          String
     purchaseOrder PurchaseOrder @relation(fields: [poId], references: [docId], onDelete: Cascade)

     itemId        String?
     description   String
     type          String?
     categoryCode  String?
     unit          String?

     quantity      Float
     receivedQty   Float      @default(0)
     unitPrice     Float
     subCategoryId Int?

     @@index([poId])
   }

model GoodsReceivedNote {
  docId         String   @id
  document      Document @relation(fields: [docId], references: [id])
  poId          String   @unique
  po            PurchaseOrder @relation(fields: [poId], references: [docId])
  supplier      String
  receivedDate  DateTime @default(now())
  
  // Generated items from this GRN
  tools         Tool[]
  consumables   ConsumableBatch[]
  reusables     ReusableItem[]
}

model ExpiryNote {
  docId     String   @id
  document  Document @relation(fields: [docId], references: [id])
  batchId   String
  batch     ConsumableBatch @relation(fields: [batchId], references: [id])
  action    String
  createdAt DateTime @default(now())
}

model GoodsIssueNote {
  docId           String    @id
  document        Document  @relation(fields: [docId], references: [id])
  status          GINStatus @default(DRAFT)
  isSiteDirect    Boolean   @default(false)
  lmrId           String?
  lmr             LorryMovementRecord? @relation(fields: [lmrId], references: [id])
  siteLocationId  String?
  siteLocation    SiteLocation? @relation(fields: [siteLocationId], references: [id])
  qrCodeDataUrl   String?
  qrPayload       String?
  
  // Transitions
  readyAt         DateTime?
  inTransitAt     DateTime?
  deliveredAt     DateTime?
  
  items           GoodsIssueNoteItem[]
}

enum GINStatus {
  DRAFT
  READY
  IN_TRANSIT
  DELIVERED
  DISCREPANCY
  RETURNING
  RTN_TRANSIT
  RECEIVED_AT_WH
  CLOSED
}

enum LMRStatus {
  LOADED
  IN_TRANSIT
  DELIVERED
  RETURNING
  RETURNED
  CLOSED
}

model LorryMovementRecord {
  id                    String        @id // Auto-created per trip
  document              Document      @relation(fields: [id], references: [id])
  vehicleId             String
  vehicle               Vehicle       @relation(fields: [vehicleId], references: [id])
  driverId              String
  driver                User          @relation("DriverRelation", fields: [driverId], references: [id])
  departureTime         DateTime      @default(now())
  status                LMRStatus     @default(LOADED)
  originLocationId      String?
  originLocation        SiteLocation? @relation("LmrOriginLocation", fields: [originLocationId], references: [id])
  destinationLocationId String?
  destinationLocation   SiteLocation? @relation("LmrDestinationLocation", fields: [destinationLocationId], references: [id])
  expectedReturnTime    DateTime?
  arrivalTime           DateTime?
  actualReturnTime      DateTime?
  remarks               String?
  gins                  GoodsIssueNote[] // Multi-cargo trips
}

model GoodsIssueNoteItem {
  id                        String           @id @default(uuid())
  ginId                     String
  gin                       GoodsIssueNote   @relation(fields: [ginId], references: [docId])
  itemType                  GINItemType
  toolId                    String?
  tool                      Tool?            @relation(fields: [toolId], references: [id])
  reusableId                String?
  reusable                  ReusableItem?    @relation(fields: [reusableId], references: [id])
  consumableId              String?
  consumable                ConsumableBatch? @relation(fields: [consumableId], references: [id])
  quantity                  Float
  scannedCount              Float            @default(0)
  returnedQuantity          Float            @default(0)
  fifoOverride              Boolean          @default(false)
  fifoOverrideReason        String?
  fifoOverrideApprovedBy    String?
  fifoOverrideApprovedAt    DateTime?
}

// ---------------------------------------------------------
// 5. History & Maintenance
// ---------------------------------------------------------

model MaintenanceRecord {
  id        String   @id @default(uuid())
  toolId    String
  tool      Tool     @relation(fields: [toolId], references: [id])
  details   String
  cost      Float
  timestamp DateTime @default(now())
}

model MovementHistory {
  id        String   @id @default(uuid())
  toolId    String
  tool      Tool     @relation(fields: [toolId], references: [id])
  location  String
  timestamp DateTime @default(now())
}
