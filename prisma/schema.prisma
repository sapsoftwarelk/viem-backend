generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------
// 1. Classification (Categories & SubCategories)
// ---------------------------------------------------------

model Category {
  id            Int           @id @default(autoincrement())
  name          String       
  slug          String        @unique
  subCategories SubCategory[]
  createdAt     DateTime      @default(now())
}

model SubCategory {
  id         Int      @id @default(autoincrement())
  name       String  
  slug       String   @unique
  code       String   @unique // DRL, LRY, CEM
  category   Category @relation(fields: [categoryId], references: [id])
  categoryId Int

  // Relations to actual items
  tools       Tool[]
  vehicles    Vehicle[]
  consumables ConsumableBatch[]
  createdAt   DateTime @default(now())
}

// ---------------------------------------------------------
// 2. Users & Roles
// ---------------------------------------------------------

model User {
  id              String   @id // Format: EMP-DRV-0001
  name            String
  employeeId      String   @unique
  photoUrl        String?
  contact         String
  department      String   // ADM, INV, SITE, DRV, REP, FIN
  roleId          String
  role            Role     @relation(fields: [roleId], references: [id])
  raisedDocuments Document[]
  tripsAsDriver   LorryMovementRecord[] @relation("DriverRelation")
}

model Role {
  id                   String  @id @default(uuid())
  name                 String  @unique // Driver, Technical Officer, CEO
  
  // Permission Matrix (16 flags)
  canCreateUsers       Boolean @default(false)
  canRaisePO           Boolean @default(false)
  canConfirmDeliveries Boolean @default(false)
  canRunAudits         Boolean @default(false)
  canLogMachineHours   Boolean @default(false)

  users                User[]
}

// ---------------------------------------------------------
// 3. Assets & Inventory
// ---------------------------------------------------------

model Tool {
  id              String   @id // Format: TOOL-DRL-0001
  subCategoryId   Int
  subCategory     SubCategory @relation(fields: [subCategoryId], references: [id])
  model           String
  serialNumber    String   @unique
  purchaseDate    DateTime
  condition       String
  
  // Machine Hours
  maxHours        Float    
  cumulativeHours Float    @default(0)
  
  status          ToolStatus @default(IN_WAREHOUSE)
  locationId      String?
  location        SiteLocation? @relation(fields: [locationId], references: [id])

  maintenance     MaintenanceRecord[]
  movements       MovementHistory[]
}

enum ToolStatus {
  PROCURED
  IN_WAREHOUSE
  READY
  IN_TRANSIT
  ON_SITE
  RETURN_INITIATED
  RETURNING
  RECEIVED_AT_WH
  DAMAGED
  IN_REPAIR
  INSPECTION
  SCRAPPED
}

model Vehicle {
  id            String   @id // Format: VEH-LRY-0001
  subCategoryId Int
  subCategory   SubCategory @relation(fields: [subCategoryId], references: [id])
  trips         LorryMovementRecord[]
}

model ConsumableBatch {
  id              String   @id // Format: CONS-CEM-2026-04-29-001
  subCategoryId   Int
  subCategory     SubCategory @relation(fields: [subCategoryId], references: [id])
  receivedDate    DateTime @default(now()) // For FIFO
  expiryDate      DateTime
  quantity        Float    
  originalBatchId String?  // For partial returns to preserve FIFO
  locationId      String?
  location        SiteLocation? @relation(fields: [locationId], references: [id])
}

model ReusableItem {
  id       String @id // Format: REUS-SCF-0001-P003
  bundleId String
  pieceNum Int
}

model SiteLocation {
  id          String   @id // Format: SITE-COL-0001-A-L3-S2
  siteName    String
  tools       Tool[]
  consumables ConsumableBatch[]
}

// ---------------------------------------------------------
// 4. Document System (16 Types)
// ---------------------------------------------------------

model Document {
  id              String   @id // Format: GIN-2026-04-29-001
  type            DocType
  createdAt       DateTime @default(now())
  creatorId       String
  creator         User     @relation(fields: [creatorId], references: [id])
  status          String   
  isAdminApproved Boolean  @default(false)

  poDetails       PurchaseOrder?
  ginDetails      GoodsIssueNote?
  lmrDetails      LorryMovementRecord?
}

enum DocType {
  PO
  GRN
  SRN
  GIN
  GRIN
  GRNI
  TRN
  DRN
  RWO
  SWO
  THN
  EXN
  MHL
  IAR
  PAR
  LMR
}

model PurchaseOrder {
  docId        String   @id
  document     Document @relation(fields: [docId], references: [id])
  supplier     String
  totalCost    Float
  expectedDate DateTime
}

model GoodsIssueNote {
  docId        String    @id
  document     Document  @relation(fields: [docId], references: [id])
  status       GINStatus @default(DRAFT)
  isSiteDirect Boolean   @default(false)
  lmrId        String?
  lmr          LorryMovementRecord? @relation(fields: [lmrId], references: [id])
  
  // Transitions
  readyAt      DateTime?
  inTransitAt  DateTime?
  deliveredAt  DateTime?
}

enum GINStatus {
  DRAFT
  READY
  IN_TRANSIT
  DELIVERED
  DISCREPANCY
  RETURNING
  RTN_TRANSIT
  RECEIVED_AT_WH
  CLOSED
}

model LorryMovementRecord {
  id            String   @id // Auto-created per trip
  document      Document @relation(fields: [id], references: [id])
  vehicleId     String
  vehicle       Vehicle  @relation(fields: [vehicleId], references: [id])
  driverId      String
  driver        User     @relation("DriverRelation", fields: [driverId], references: [id])
  departureTime DateTime @default(now())
  gins          GoodsIssueNote[] // Multi-cargo trips
}

// ---------------------------------------------------------
// 5. History & Maintenance
// ---------------------------------------------------------

model MaintenanceRecord {
  id        String   @id @default(uuid())
  toolId    String
  tool      Tool     @relation(fields: [toolId], references: [id])
  details   String
  cost      Float
  timestamp DateTime @default(now())
}

model MovementHistory {
  id        String   @id @default(uuid())
  toolId    String
  tool      Tool     @relation(fields: [toolId], references: [id])
  location  String
  timestamp DateTime @default(now())
}